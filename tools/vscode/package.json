{
  "name": "lite-step",
  "displayName": "Lite-STEP",
  "description": "IFC sync, Lite-STEP compilation, and 3D preview",
  "version": "1.2.0",
  "publisher": "lite-step",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "workspaceContains:**/*.ifc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "litestep.previewFile",
        "title": "Preview Model",
        "icon": "$(eye)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.startServer",
        "title": "Start Server",
        "icon": "$(radio-tower)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.stopServer",
        "title": "Stop Server",
        "icon": "$(debug-stop)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.pushToWeb",
        "title": "Push Model to Web",
        "icon": "$(cloud-upload)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.pushToWebNewProject",
        "title": "Push Model to Web as New Project",
        "icon": "$(new-folder)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.pushToBlender",
        "title": "Push Model to Blender",
        "icon": "$(symbol-misc)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.refresh",
        "title": "Refresh Detection",
        "icon": "$(refresh)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.refreshStatus",
        "title": "Refresh Status",
        "icon": "$(refresh)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.gitSignIn",
        "title": "Ginnung Git: Set Client Token",
        "icon": "$(key)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.gitSignOut",
        "title": "Ginnung Git: Clear Client Token",
        "icon": "$(sign-out)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.gitLinkRemote",
        "title": "Ginnung Git: Link Remote to Workspace",
        "icon": "$(plug)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.gitCloneProject",
        "title": "Ginnung Git: Clone Project",
        "icon": "$(repo-clone)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.gitPull",
        "title": "Ginnung Git: Pull from Ginnung",
        "icon": "$(repo-pull)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.gitPush",
        "title": "Ginnung Git: Push to Ginnung",
        "icon": "$(repo-push)",
        "category": "Lite-STEP"
      },
      {
        "command": "litestep.gitUnlinkRemote",
        "title": "Ginnung Git: Unlink Remote",
        "icon": "$(debug-disconnect)",
        "category": "Lite-STEP"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "litestep-explorer",
          "title": "Lite-STEP",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "litestep-explorer": [
        {
          "id": "litestep.statusView",
          "name": "Lite-STEP Bridge & Connections",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "litestep.refreshStatus",
          "when": "view == litestep.statusView",
          "group": "navigation@1"
        },
        {
          "command": "litestep.startServer",
          "when": "view == litestep.statusView",
          "group": "navigation@2"
        },
        {
          "command": "litestep.stopServer",
          "when": "view == litestep.statusView",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "litestep.previewFile",
          "when": "resourceExtname == .py || resourceExtname == .ifc",
          "group": "navigation@1"
        },
        {
          "command": "litestep.pushToWeb",
          "when": "resourceExtname == .py || resourceExtname == .ifc",
          "group": "navigation@2"
        },
        {
          "command": "litestep.pushToWebNewProject",
          "when": "resourceExtname == .py || resourceExtname == .ifc",
          "group": "navigation@2"
        },
        {
          "command": "litestep.pushToBlender",
          "when": "resourceExtname == .py || resourceExtname == .ifc",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "litestep.previewFile",
          "when": "resourceExtname == .py || resourceExtname == .ifc",
          "group": "navigation@1"
        },
        {
          "command": "litestep.pushToWeb",
          "when": "resourceExtname == .py || resourceExtname == .ifc",
          "group": "navigation@2"
        },
        {
          "command": "litestep.pushToBlender",
          "when": "resourceExtname == .py || resourceExtname == .ifc",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Lite-STEP",
      "properties": {
        "litestep.port": {
          "type": "number",
          "default": 9877,
          "description": "WebSocket server port for Lite-STEP VS Code extension"
        },
        "litestep.blenderPort": {
          "type": "number",
          "default": 9876,
          "description": "WebSocket port of the Blender Lite-STEP server"
        },
        "litestep.liteStepPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the local lite-step repository containing the compiler"
        },
        "litestep.liteStepCommand": {
          "type": "string",
          "default": "python -m lite_step",
          "description": "Command to invoke the Lite-STEP compiler"
        },
        "litestep.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable to invoke for Lite-STEP compilation"
        },
        "litestep.allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra web origins allowed to connect to the local server, besides the built-in `https://ginnung.tech`. Each entry is a bare origin matched exactly, for example `https://app.example.com`. It must be `https://`; `http://` is accepted only on `localhost` or `127.0.0.1` (for example `http://localhost:5173`). No wildcards, paths or trailing slash. Restart the server after changing it."
        },
        "litestep.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the WebSocket server on activation"
        },
        "litestep.apiBaseUrl": {
          "type": "string",
          "default": "https://api.ginnung.tech",
          "description": "Base URL of the Ginnung API used to mint Cloudflare Artifacts Git tokens (for example https://api.ginnung.tech or https://staging-api.grab.technology)"
        },
        "litestep.gitRemoteName": {
          "type": "string",
          "default": "ginnung",
          "description": "Named Git remote managed by the Lite-STEP extension (keeps origin untouched)"
        },
        "litestep.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to Node.js binary used by the repo-local Ginnung Git credential helper (auto-detected if empty)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package --no-dependencies",
    "lint": "tsc --noEmit",
    "build:cli": "esbuild src/bridge-cli.ts --bundle --platform=node --format=cjs --target=node20 --outfile=out-cli/bridge-cli.js --log-level=warning",
    "build:helper": "esbuild src/git-credential-helper.ts --bundle --platform=node --format=cjs --target=node20 --banner:js=\"#!/usr/bin/env node\" --outfile=out/git-credential-ginnung.js --log-level=warning",
    "test": "npm run build:cli && npm run build:helper && esbuild test/*.test.ts --bundle --platform=node --format=cjs --outdir=out-test --log-level=warning && node --test --test-force-exit \"out-test/*.js\""
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  }
}
